# ============================================================
# MediSense AI — Frontend Environment Variables (.env.example)
# Copy this file to `frontend/.env` if you want to override defaults.
# When running locally, Vite defaults to proxying /api to http://localhost:5000.
# ============================================================

# Backend API URL (leave blank for local dev proxy via Vite)
VITE_API_URL=http://localhost:5000

# WebSocket / Socket.IO Server URL
VITE_SOCKET_URL=http://localhost:5000

# Vapi Public Key (find this on https://dashboard.vapi.ai)
# Note: The backend also securely provides this during /api/v1/ai-doctor/start-call
VITE_VAPI_PUBLIC_KEY=your_vapi_public_key_here
