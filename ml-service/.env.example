# ============================================================
# MediSense AI — ML Service Environment Variables (.env.example)
# Copy this file to `ml-service/.env` for standalone Python execution.
# ============================================================

# Shared secret key matching backend ML_SERVICE_INTERNAL_KEY.
# Incoming requests without this in header 'x-internal-service-key' are rejected with 401.
INTERNAL_API_KEY=CHANGE_ME_shared_secret_matching_backend

# Allowed origin for CORS (only the backend calls the ML service directly)
ALLOWED_ORIGIN=http://localhost:5000

# Path to trained ML model weights and metadata
MODEL_PATH=./app/models

# Data file paths
HEART_CSV=./data/HeartDiseaseTrain-Test.csv

# Optional DB / Redis connection for ML worker tasks
DATABASE_URL=postgresql://medisense:medisense_password@localhost:5432/medisense_db
REDIS_URL=redis://:redis_password@localhost:6379

# Debug and logging
DEBUG=False
LOG_LEVEL=INFO
